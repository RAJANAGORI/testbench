# SCAS Floci emulator — copy to .env (floci-setup.sh does this automatically)
FLOCI_PORT=4566
FLOCI_DEFAULT_REGION=us-east-1
FLOCI_STORAGE_MODE=memory
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Set to 1 after setup when using --image (published container, no source build)
FLOCI_USE_IMAGE=0

# Published image tag when FLOCI_USE_IMAGE=1
FLOCI_IMAGE=floci/floci:latest-compat

# Socket the emulator uses to spawn Lambda / the optional /_floci/ui sidecar.
# Leave unset unless your engine is not at /var/run/docker.sock.
# FLOCI_DOCKER_SOCK=/var/run/docker.sock
# GID is auto-detected on Linux (and via a tiny alpine probe on Docker Desktop / Colima).
# FLOCI_DOCKER_GID=
# Podman + SELinux last resort if /_floci/ui still says BindException Permission denied:
# FLOCI_SELINUX_DISABLE=0
